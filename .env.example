# Kalshi API credentials
KALSHI_API_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=config/kalshi-private-key.pem
KALSHI_ENV=production            # production | demo

# Supabase (trade ledger + portfolio snapshots mirror — optional; the bot
# runs fine without these, it just skips the Supabase sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Bot behavior (CLI flags override these if both are set)
POLL_INTERVAL_SECONDS=300
MIN_EDGE_CENTS=2
MAX_POSITION_CONTRACTS=5
MAX_TOTAL_EXPOSURE_DOLLARS=      # informational; runtime cap is --max-exposure-pct
DRY_RUN=true

# Risk guardrails (defaults live in scripts/run_bot.py; documented here for ops)
# TAKE_PROFIT_PCT=0.15           # sell at entry * (1 + this) once filled
# STOP_LOSS_PCT=0.50             # exit once price falls this fraction below entry
# DAILY_LOSS_LIMIT_PCT=0.20      # halt live orders after losing this fraction of start-of-day balance
# MAX_EXPOSURE_PCT=0.30          # cap open positions at this fraction of balance
# PER_TRADE_PCT=0.10             # cap one trade at this fraction of balance
# MAX_HOURS_TO_CLOSE=12          # skip markets closing more than this many hours out
# MIN_MARKET_VOLUME=1000000      # skip markets with total volume under this many dollars
