# Demo paper trader. Copy to trader/.env (never commit).
# Live money is a later spec. Production Trade API hosts crash on boot.
# Docs: https://docs.kalshi.com/getting_started/demo_env
KALSHI_ENV=demo
KALSHI_REST_BASE=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2
KALSHI_TRADING_ENABLED=false
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
SUPABASE_URL=https://axdikbsghdotugnotzof.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
MIN_NET_EDGE_CENTS=1
CONTRACTS=20
DEMO_ORDER_CONTRACTS=1
KALSHI_TIME_IN_FORCE=fill_or_kill
MAX_SUBSCRIPTIONS=40
PORT=8080
